{
    "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
    "general": {
        "preload": {
            "lua": "function sysinfo(a) S = S or dofile((a.homeDir:gsub('/*$', '/')) .. '.config/fastfetch/sysinfo.lua') return S end"
        }
    },
    "logo": {
        "type": "kitty-direct",
        "source": "~/.config/fastfetch/cat_at_play.png",
        "width": 46,
        "height": 27,
        "padding": { "top": 1, "left": 1, "right": 1 }
    },
    "display": {
        "key": { "type": "none" },
        "disableLinewrap": true
    },
    "modules": [
        { "type": "title", "format": "lua: return sysinfo(...).header()" },
        { "type": "os", "format": "lua: return S.include(...)" },
        { "type": "custom", "format": "lua: return S.blank()" },
        { "type": "title", "format": "lua: return S.struct(...)" },
        { "type": "title", "format": "lua: return S.host(...)" },
        { "type": "os", "format": "lua: return S.os(...)" },
        { "type": "kernel", "format": "lua: return S.kernel(...)" },
        { "type": "initsystem", "format": "lua: return S.init(...)" },
        { "type": "packages", "format": "lua: return S.packages(...)" },
        { "type": "uptime", "format": "lua: return S.uptime(...)" },
        {
            "type": "command",
            "text": "set -- $(findmnt -no FSTYPE,SOURCE / 2>/dev/null); if [ \"$1\" = zfs ]; then d=$(echo \"$2\" | cut -d/ -f1-2); t=$(zfs get -Hpo value creation \"$d\" 2>/dev/null); else t=$(stat -c %W / 2>/dev/null); fi; [ \"$t\" -gt 0 ] 2>/dev/null && echo \"$(( ($(date +%s) - t) / 86400 )) $(date -d \"@$t\" +%F) $d\"",
            "format": "lua: return S.age(...)"
        },
        { "type": "wm", "format": "lua: return S.wm(...)" },
        { "type": "terminal", "format": "lua: return S.terminal(...)" },
        { "type": "shell", "format": "lua: return S.shell(...)" },
        { "type": "terminalfont", "format": "lua: return S.font(...)" },
        { "type": "cpu", "format": "lua: return S.cpu(...)" },
        { "type": "gpu", "format": "lua: return S.gpu(...)" },
        { "type": "memory", "format": "lua: return S.memory(...)" },
        {
            "type": "command",
            "text": "o=0; c=0; s=0; a=; for d in /sys/block/zram*; do [ -r \"$d/mm_stat\" ] && [ \"$(cat \"$d/disksize\")\" -gt 0 ] || continue; set -- $(cat \"$d/mm_stat\"); o=$((o + $1)); c=$((c + $2)); s=$((s + $(cat \"$d/disksize\"))); [ -n \"$a\" ] || a=$(awk -F'[][]' '{print $2}' \"$d/comp_algorithm\"); done; [ \"$s\" -gt 0 ] && echo \"$o $c $s $a\"",
            "format": "lua: return S.zram(...)"
        },
        { "type": "disk", "folders": "/", "format": "lua: return S.disk(...)" },
        { "type": "display", "format": "lua: return S.display(...)" },
        { "type": "custom", "format": "lua: return S.close()" },
        { "type": "custom", "format": "lua: return S.blank()" },
        { "type": "custom", "format": "lua: return S.palette()" },
        { "type": "custom", "format": "lua: return S.palette(1)" },
        { "type": "custom", "format": "lua: return S.palette(2)" },
        { "type": "custom", "format": "lua: return S.close()" },
        { "type": "custom", "format": "lua: return S.blank()" },
        { "type": "datetime", "format": "lua: return S.main(...)" },
        { "type": "custom", "format": "lua: return S.statusline()" },
        { "type": "custom", "format": "lua: return S.cmdline()" }
    ]
}
